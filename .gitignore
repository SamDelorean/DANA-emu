# Protection against committing commercially owned guest firmware, private media,
# secrets, build output, and emulator working state.
# Gitignore does not remove files already tracked or present in Git history.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.keystore
id_rsa*
id_ed25519*
.secrets/
secrets/
private/
roms/
firmware/
dumps/
images/rom/
*.rom
*.ROM
*.bin
*.BIN
*.flash
*.nvram
*.dmp
*.core
*.sav
*.img
*.iso
*.nib
*.zst
/build/
/out/
/dist/
/obj/
/bin/
/runtime/
/user-data/
/nvram/
/snapshots/
/test-output/
/artifacts/
__pycache__/
*.pyc
.DS_Store
Thumbs.db
