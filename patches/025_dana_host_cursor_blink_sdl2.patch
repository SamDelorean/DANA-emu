+	// Dana stylus UX (025): preserve absolute SDL lightgun input without
+	// capturing the desktop pointer.  The cursor is shown immediately during
+	// motion, and blinks only when stationary.  No guest mouse injection.
+	if (!std::strcmp(machine().system().name, "asmdana") && !fullscreen()
+			&& !(machine().debug_flags & DEBUG_FLAG_OSD_ENABLED))
+	{
+		char const *const mode = SDL_getenv("DANA_HOST_CURSOR");
+		if (!mode || std::strcmp(mode, "legacy"))
+		{
+			release_pointer(); // never enter SDL relative/grab mode for Dana
+			if (SDL_GetMouseFocus() != platform_window())
+			{
+				m_dana_cursor_tracking = false;
+				show_pointer();
+			}
+			else if (mode && !std::strcmp(mode, "show"))
+			{
+				m_dana_cursor_tracking = false;
+				show_pointer();
+			}
+			else
+			{
+				int x = 0, y = 0;
+				SDL_GetMouseState(&x, &y);
+				Uint32 const now = SDL_GetTicks();
+				if (!m_dana_cursor_tracking || (x != m_dana_cursor_x) || (y != m_dana_cursor_y))
+				{
+					m_dana_cursor_tracking = true;
+					m_dana_cursor_x = x;
+					m_dana_cursor_y = y;
+					m_dana_last_motion = now;
+				}
+				Uint32 const idle = now - m_dana_last_motion; // wrap-safe
+				if ((idle < 500U) || (((idle - 500U) % 1000U) < 600U))
+					show_pointer();
+				else
+					hide_pointer();
+			}
+			SDL_SetCursor(nullptr);
+			return;
+		}
+	}
+
 	// do not do mouse capture if the debugger's enabled to avoid
